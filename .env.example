# ==========================================
# DB-GENERATOR MONOREPO ENVIRONMENT TEMPLATE
# Copy this file to .env.local and fill in your values
# ==========================================

# Frontend Backend Communication
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Supabase PostgreSQL Database & Auth
# Get these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Groq AI Service (3NF Schema Generation)
# Get this from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Backend Express Server
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
APP_URL=http://localhost:3000

# Resend Email Verification Service
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=DB-Generator Studio <onboarding@resend.dev>
